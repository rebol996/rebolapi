generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("member")
  status    String   @default("active")
  quota     Float    @default(0)
  quotaType String   @default("tokens")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys         UserApiKey[]
  modelPermissions UserModelPermission[]
  usageLogs       UsageLog[]
  quotaRecords    QuotaRecord[]
  createdInviteCodes InviteCode[]
  quotaChanges    QuotaRecord[] @relation("OperatorRelation")
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  createdBy String

  creator User @relation(fields: [createdBy], references: [id])
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  baseUrl     String
  apiKey      String
  type        String   @default("openai-compatible")
  status      String   @default("active")
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models Model[]
}

model Model {
  id            String   @id @default(cuid())
  name          String
  modelId       String
  providerId    String
  contextLength Int      @default(4096)
  inputPrice    Float    @default(0)
  outputPrice   Float    @default(0)
  capability    String   @default("[]")
  status        String   @default("active")
  isDefault     Boolean  @default(false)
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      Provider @relation(fields: [providerId], references: [id])
  permissions   UserModelPermission[]
  usageLogs     UsageLog[]
}

model UserModelPermission {
  id      String @id @default(cuid())
  userId  String
  modelId String

  user  User  @relation(fields: [userId], references: [id])
  model Model @relation(fields: [modelId], references: [id])

  @@unique([userId, modelId])
}

model UserApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @unique
  status    String   @default("active")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id])
}

model UsageLog {
  id           String   @id @default(cuid())
  userId       String
  modelId      String
  source       String   @default("api")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cost         Float    @default(0)
  duration     Int      @default(0)
  status       String   @default("success")
  errorMsg     String?
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  model Model @relation(fields: [modelId], references: [id])
}

model QuotaRecord {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  reason    String
  operatorId String
  createdAt DateTime @default(now())

  user     User @relation(fields: [userId], references: [id])
  operator User @relation("OperatorRelation", fields: [operatorId], references: [id])
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}